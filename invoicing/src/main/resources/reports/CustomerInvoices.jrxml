<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CustomerInvoices" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="85e65705-6839-4210-8952-2b465724307d">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Invoicing"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="number" class="java.lang.Integer"/>
	<parameter name="name" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT d.DATE, 
	d.NUMBER, 
	d.TOTALAMOUNT, 
	COUNT (d.OID) as PRODUCT_VARIETIES,
    SUM (dd.QUANTITY) as PRODUCT_QUANTITIES 
FROM COMMERCIALDOCUMENT d 
LEFT JOIN COMMERCIALDOCUMENT_DETAILS dd 
ON dd.COMMERCIALDOCUMENT_OID = d.OID
WHERE d.CUSTOMER_NUMBER =  $P{number}
	AND d.DTYPE = 'Invoice' 
	AND d.DELIVERED = false 
	AND d.DELETED = false
GROUP BY d.OID
]]>
	</queryString>
