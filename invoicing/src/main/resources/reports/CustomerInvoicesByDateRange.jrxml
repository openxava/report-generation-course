<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CustomerInvoicesByDateRange" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="353ac7d9-c244-4fbf-9cd2-2c3957c7bf3f">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Invoicing"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="627"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="359"/>
	<parameter name="number" class="java.lang.Integer"/>
	<parameter name="startDate" class="java.lang.String"/>
	<parameter name="endDate" class="java.lang.String"/>
	<parameter name="name" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT d.DATE,
	d.NUMBER,
	d.TOTALAMOUNT,
	COUNT (d.OID) as PRODUCT_VARIETIES, 
	SUM (dd.QUANTITY) as PRODUCT_QUANTITIES 
FROM PUBLIC.COMMERCIALDOCUMENT d 
LEFT JOIN PUBLIC.COMMERCIALDOCUMENT_DETAILS dd 
ON dd.COMMERCIALDOCUMENT_OID = d.OID 
WHERE  d.CUSTOMER_NUMBER = $P{number}
	AND d.DTYPE = 'Invoice' 
	AND d.DELIVERED = false 
	AND d.DELETED = false 
	AND d.DATE BETWEEN $P{startDate} AND $P{endDate} 
GROUP BY d.OID]]>
	</queryString>
