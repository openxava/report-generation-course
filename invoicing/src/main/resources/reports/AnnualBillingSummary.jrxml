<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="AnnualBillingSummary" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d851951d-5893-4a65-bc3d-72c858e780c1">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Invoicing"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<queryString>
		<![CDATA[SELECT 
c.NAME, 
c.STATE, 
c.CITY, 
count (C.NUMBER) AS COUNT, 
sum(d.TOTALAMOUNT) AS TOTALAMOUNT 
FROM CUSTOMER c 
Left Join COMMERCIALDOCUMENT d 
ON c.NUMBER = d.CUSTOMER_NUMBER 
WHERE  d.DTYPE = 'Invoice' 
	AND d.DELETED = false 
	AND YEAR(d.DATE) = 2024 
GROUP BY c.NAME, 
	c.STATE, 
	c.CITY 
ORDER BY c.STATE ASC, 
	c.CITY ASC]]>
	</queryString>
